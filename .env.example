# Postgres connection string (Neon, Supabase, etc.).
# Leave empty in development to use the embedded database in .data/pglite.
DATABASE_URL=
# Set to 1 to use the local embedded database even though DATABASE_URL is set.
USE_EMBEDDED_DB=

# Public URL of the site, used in password reset emails. Defaults to the request's host.
APP_URL=

# Password reset emails are sent with Resend (https://resend.com). Without these, the
# reset link is printed to the server log instead, which is fine for local development.
RESEND_API_KEY=
EMAIL_FROM="UnitCMS <hello@your-domain.com>"

# Optional. Lets scripts create projects through POST /v1/projects. Use a long random value.
UNITCMS_MASTER_KEY=
